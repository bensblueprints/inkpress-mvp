# Inkpress configuration — copy to .env (or export in your shell / compose file)

# Port the server listens on
PORT=5330

# Password for the /admin dashboard. CHANGE THIS before deploying.
ADMIN_PASSWORD=admin

# Canonical base URL used for RSS, sitemap.xml, OG/canonical tags.
# MUST be set to your real public URL in production (e.g. https://blog.example.com) —
# leaving it as localhost will break RSS reader links and social previews.
BASE_URL=http://localhost:5330

# Where the SQLite database + uploaded images live (defaults to ./data)
# DATA_DIR=/data
